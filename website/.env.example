# Local and Vercel configuration. Add real values in Vercel Project Settings,
# not to this file. A Vercel deployment requires a managed MySQL-compatible DB.
DATABASE_URL=mysql://user:password@host:port/database
DB_SSL=true

# Generate unique, long random values for each deployment environment.
JWT_SECRET=replace_with_a_long_random_secret
SESSION_SECRET=replace_with_a_different_long_random_secret

# Vercel production URL (no trailing slash).
APP_URL=https://your-project.vercel.app
FRONTEND_URL=https://your-project.vercel.app

# Optional Google sign-in; add this callback URL in Google Cloud Console.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-project.vercel.app/auth/google/callback

# Server-side only: never prefix these with VITE_.
GROQ_API_KEY=your_groq_api_key
SERPER_API_KEY=your_serper_api_key

# Leave blank for the single Vercel deployment. The client then calls same-origin /api routes.
VITE_API_URL=
VITE_ALITAPTAP_API_URL=https://your-fastapi-service.example/api/v1
